<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>{{.Title}}</title>
<style>
:root{color-scheme:light dark}*{box-sizing:border-box}body{font:15px/1.6 system-ui,sans-serif;margin:0;background:light-dark(#f4f6f9,#101720);color:light-dark(#182437,#e4eaf2)}main{max-width:1050px;margin:auto;padding:28px}nav{display:flex;gap:22px;flex-wrap:wrap}a{color:light-dark(#1d4ed8,#93b6ff)}h1{font-size:26px;margin:24px 0 4px}p{color:light-dark(#526174,#a7b5c8)}dl{display:grid;grid-template-columns:minmax(150px,240px) minmax(0,1fr);gap:8px 24px;padding:20px;background:light-dark(#fff,#192333);border-radius:10px}dt{color:light-dark(#526174,#a7b5c8)}dd{margin:0;overflow-wrap:anywhere}pre{white-space:pre-wrap;overflow-wrap:anywhere;padding:20px;background:light-dark(#fff,#192333);border-radius:10px;font-size:13px}button{font:inherit;padding:7px 12px;border-radius:6px;border:1px solid light-dark(#becbdc,#4c607b);background:light-dark(#fff,#192333);color:inherit;cursor:pointer}h2{font-size:19px}.table-wrap{overflow:auto}table{width:100%;border-collapse:collapse;font-size:13px}th,td{padding:9px;text-align:left;border-bottom:1px solid light-dark(#dce3ee,#344055)}summary{cursor:pointer}section{margin-top:28px}@media(max-width:540px){main{padding:18px}dl{grid-template-columns:1fr;gap:2px}dd{margin-bottom:12px}}
</style></head><body><main>
<nav><a href="{{.IndexURL}}" target="_top">All results</a><a href="{{.MapURL}}">Open map</a></nav>
<h1>{{.Title}}</h1><p>These settings were recorded when this output was created. Editing config.yaml does not change an existing result.</p>
<dl>{{range .Fields}}<dt>{{.Name}}</dt><dd>{{.Value}}</dd>{{end}}</dl>
{{if .Evaluations}}<section><h2>Greedy evaluation per seed</h2><p>Final evaluation uses epsilon = 0. Overlap is a ratio from 0 to 1.</p><div class="table-wrap"><table><thead><tr><th>Seed</th><th>Scenario</th><th>Termination</th><th>Distance (m)</th><th>Error (m)</th><th>Reward</th><th>Comfort</th><th>Overlap</th></tr></thead><tbody>{{range .Evaluations}}<tr><td>{{.Seed}}</td><td>{{.Scenario}}</td><td>{{.Result}}</td><td>{{.Distance}}</td><td>{{.Error}}</td><td>{{.Reward}}</td><td>{{.Comfort}}</td><td>{{.Overlap}}</td></tr>{{end}}</tbody></table></div></section>{{end}}
{{if .ConfigJSON}}<section><h2>Effective Q-learning configuration</h2><pre>{{.ConfigJSON}}</pre></section>{{end}}
<section><details><summary>Complete recorded configuration and provenance</summary><p>Includes reward parameters, actual seeds, graph identity, algorithm rules, build information, and available evaluation summaries.</p><button id="copy" type="button">Copy metadata</button><span id="copy-status" role="status"></span><pre id="metadata">{{.JSON}}</pre></details></section>
</main><script>document.getElementById('copy').addEventListener('click',async()=>{const status=document.getElementById('copy-status');try{await navigator.clipboard.writeText(document.getElementById('metadata').textContent);status.textContent=' Copied';}catch{status.textContent=' Select the metadata text to copy it.';}});</script></body></html>
