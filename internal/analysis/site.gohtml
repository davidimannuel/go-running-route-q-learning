<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>{{.Title}}</title>
<style>
*{box-sizing:border-box}body{margin:0;font:14px/1.5 system-ui,sans-serif;background:#f5f7fb;color:#1b2940}a{color:#2351ba}button,input,select{font:inherit;border:1px solid #cad4e2;border-radius:7px;background:white;padding:8px 10px}button{cursor:pointer}header{padding:14px 20px;border-bottom:1px solid #dce3ee}h1{font-size:21px;margin:0}header p{margin:5px 0;color:#5f6e84}.layout{display:grid;grid-template-columns:340px minmax(0,1fr);height:calc(100dvh - 104px)}aside{padding:16px;overflow:auto;border-right:1px solid #dce3ee}.filters{display:grid;gap:8px}label{display:grid;gap:3px}ul{list-style:none;padding:0}li{padding:14px 0;border-bottom:1px solid #dce3ee}li.selected{border-left:3px solid #2457f5;padding-left:10px}.result{font-weight:650;display:block;overflow-wrap:anywhere}.muted{color:#5f6e84;font-size:12px;overflow-wrap:anywhere}.actions{display:flex;gap:14px;margin:8px 0}.seed-links{padding-left:18px;font-size:12px}.seed-links li{border:0;padding:4px 0}.viewer{min-width:0;display:flex;flex-direction:column}.toolbar{padding:12px;display:flex;gap:12px;align-items:center;flex-wrap:wrap;background:white}#selected{flex:1;overflow-wrap:anywhere}iframe{border:0;width:100%;flex:1;min-height:450px;background:white}[hidden]{display:none!important}#empty{padding:20px}a:focus-visible,button:focus-visible{outline:3px solid #5389ef;outline-offset:3px}@media(max-width:760px){.layout{height:auto;grid-template-columns:1fr}aside{max-height:340px;border-right:0}iframe{height:75dvh}.toolbar #selected{flex-basis:100%}}
</style></head><body>
<header><h1>{{.Title}}</h1><p>Saved results · {{.Mode}} map mode · choose a result and seed. {{if eq .Mode "advanced"}}Q-values require CLI serve; other map features use embedded data.{{else}}Maps and recorded settings work without a Go backend.{{end}}</p></header>
<div class="layout"><aside><div class="filters"><label>Find a result<input id="search" type="search" placeholder="Profile, scenario, or seed"></label><label>Result type<select id="kind"><option value="">All results</option><option value="training">Training</option><option value="analysis">Analysis</option></select></label><label>Evaluation<select id="valid"><option value="">All evaluations</option><option value="valid">Has a valid loop</option></select></label></div><p id="count" class="muted"></p><ul id="results">
{{range .Entries}}<li class="entry" data-kind="{{.Kind}}" data-valid="{{range .Seeds}}{{if .IsLoop}}yes{{end}}{{end}}"><a class="result" href="{{.MapURL}}" target="preview" data-map="{{.MapURL}}" data-details="{{.DetailsURL}}">{{.Name}}{{if .Scenario}} · Scenario {{.Scenario}}{{end}}</a><div class="muted">Saved completion: {{.CompletedAt}}</div><div class="actions"><a class="details" href="{{.DetailsURL}}" target="preview">Recorded settings</a><a href="{{.MapURL}}" target="_blank" rel="noopener">Open map ↗</a></div>{{if .Seeds}}<details><summary>{{len .Seeds}} seed(s)</summary><ul class="seed-links">{{range .Seeds}}<li><a class="seed-link" href="{{.URL}}" target="preview">Seed {{.ID}}</a> · {{.Distance}} m · {{if .IsLoop}}valid loop{{else}}{{.Result}}{{end}}{{if .Representative}} · representative{{end}}</li>{{end}}</ul></details>{{end}}</li>{{end}}
</ul><p class="muted">Results describe the saved graph and research preferences. Field-validation status must be checked separately. Training and Q-tables are not run in your browser.</p></aside>
<section class="viewer"><div class="toolbar"><strong id="selected">Select a result</strong><a id="map-link" target="preview" hidden>Map</a><a id="details-link" target="preview" hidden>Recorded settings</a><a id="open-link" target="_blank" rel="noopener" hidden>Open separately ↗</a><button id="share" hidden>Copy link</button><span id="share-status" role="status"></span></div><p id="empty">Choose a result on the left.</p><iframe id="preview" name="preview" title="Selected result" hidden></iframe></section></div>
<script>
(()=>{
 const rows=[...document.querySelectorAll('.entry')],frame=document.getElementById('preview'),mapLink=document.getElementById('map-link'),detailsLink=document.getElementById('details-link'),openLink=document.getElementById('open-link'),share=document.getElementById('share');
 let active=null;
 function record(seed){const url=new URL(location.href);url.searchParams.set('route',active.querySelector('.result').dataset.map);if(seed)url.searchParams.set('seed',seed);else url.searchParams.delete('seed');history.replaceState(null,'',url);}
 function select(row,target){const previousMap=active===row?mapLink.href:null;active=row;for(const item of rows)item.classList.toggle('selected',item===row);const link=row.querySelector('.result'),url=new URL(target,location.href);document.getElementById('selected').textContent=link.textContent;const seed=url.searchParams.get('seed')||(previousMap?new URL(previousMap).searchParams.get('seed'):null),mapURL=new URL(link.href);if(seed)mapURL.searchParams.set('seed',seed);mapLink.href=mapURL.href;detailsLink.href=link.dataset.details;openLink.href=url;mapLink.hidden=detailsLink.hidden=openLink.hidden=share.hidden=frame.hidden=false;document.getElementById('empty').hidden=true;frame.src=url.href;record(seed);}
 for(const row of rows)for(const link of row.querySelectorAll('.result,.details,.seed-link'))link.addEventListener('click',event=>{event.preventDefault();select(row,link.href);});
 for(const link of [mapLink,detailsLink])link.addEventListener('click',event=>{if(active){event.preventDefault();select(active,link.href);}});
 function filter(){const terms=document.getElementById('search').value.toLowerCase().trim().split(/\s+/).filter(Boolean),kind=document.getElementById('kind').value,valid=document.getElementById('valid').value;let count=0;for(const row of rows){row.hidden=!terms.every(term=>row.textContent.toLowerCase().includes(term))||(kind&&row.dataset.kind!==kind)||(valid&&!row.dataset.valid);if(!row.hidden)count++;}document.getElementById('count').textContent=`${count} / ${rows.length} result(s)`;}
 for(const id of ['search','kind','valid'])document.getElementById(id).addEventListener(id==='search'?'input':'change',filter);filter();
 function syncFrame(){try{if(!active||frame.contentWindow.location.href==='about:blank')return;const url=new URL(frame.contentWindow.location.href);openLink.href=url.href;if(url.pathname.endsWith('/routes.html')){mapLink.href=url.href;record(url.searchParams.get('seed'));}}catch{}}
 frame.addEventListener('load',()=>{syncFrame();try{frame.contentDocument.getElementById('seed')?.addEventListener('change',syncFrame);}catch{}});
 share.addEventListener('click',async()=>{try{if(active){record(new URL(mapLink.href).searchParams.get('seed'));}await navigator.clipboard.writeText(location.href);document.getElementById('share-status').textContent='Link copied';}catch{document.getElementById('share-status').textContent='Copy the address from your browser.';}});
 const requested=new URL(location.href),row=rows.find(row=>row.querySelector('.result').dataset.map===requested.searchParams.get('route'));if(row){const url=new URL(row.querySelector('.result').href);if(requested.searchParams.has('seed'))url.searchParams.set('seed',requested.searchParams.get('seed'));select(row,url.href);}
})();
</script></body></html>
